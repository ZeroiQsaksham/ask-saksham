# Copy this file to .env and fill in your values. Never commit .env.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model id (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Display name of the agent (rename "XYZ" whenever you decide)
AGENT_NAME=XYZ
OWNER_NAME=Saksham

# Retrieval settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=4

# Basic abuse protection: requests per IP per minute
RATE_LIMIT_PER_MINUTE=15
