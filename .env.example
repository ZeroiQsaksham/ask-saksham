# Copy this file to .env and fill in your values. Never commit .env.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model id (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# Display name of the agent
AGENT_NAME=Saksham
OWNER_NAME=Saksham

# Retrieval settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=6

# Astrologer mode (book-based answers). Put the PDF in books/
ASTRO_TOP_K=5

# Basic abuse protection: requests per IP per minute
RATE_LIMIT_PER_MINUTE=15
